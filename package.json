{
  "name": "mount-observer",
  "version": "0.1.1",
  "description": "Observe and act on css matches.",
  "main": "MountObserver.js",
  "module": "MountObserver.js",
  "dependencies": {
    "assign-gingerly": "0.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.0",
    "spa-ssi": "0.0.26"
  },
  "exports": {
    ".": {
      "default": "./index.js",
      "types": "./index.ts"
    },
    "./MountObserver.js": {
      "default": "./MountObserver.js",
      "types": "./MountObserver.ts"
    },
    "./whereOutside.js": {
      "default": "./whereOutside.js",
      "types": "./whereOutside.ts"
    },
    "./emitEvents.js": {
      "default": "./emitEvents.js",
      "types": "./emitEvents.ts"
    }
  },
  "files": [
    "*.js",
    "*.ts"
  ],
  "types": "./types.d.ts",
  "scripts": {
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "author": "Bruce B. Anderson <anderson.bruce.b@gmail.com>",
  "license": "MIT"
}
